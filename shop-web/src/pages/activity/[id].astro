---
import Base from '@/layouts/Base.astro';
import ActivityDetail from '@/views/activity/ActivityDetail.vue';
import { useDict } from '@/i18n';

const { d, href, locale } = useDict(Astro.locals.locale);

// 路径里进来的是字符串，非数（/activity/abc）直接打发回活动列表，不带着 NaN 去请求接口
const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect(href('/activity'));
---

<Base title={d.page.activityDetail.title} description={d.page.activityDetail.desc}>
  <ActivityDetail client:load locale={locale} activityId={id} />
</Base>
