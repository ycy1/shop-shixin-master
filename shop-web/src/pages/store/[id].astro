---
import Base from '@/layouts/Base.astro';
import StoreDetail from '@/views/store/StoreDetail.vue';
import { useDict } from '@/i18n';

const { d, href, locale } = useDict(Astro.locals.locale);

// 路径里进来的是字符串，非数（/store/abc）直接打发回门店列表，不带着 NaN 去请求接口
const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect(href('/search?tab=store'));
---

<Base title={d.page.store.title} description={d.page.store.desc}>
  <StoreDetail client:load locale={locale} storeId={id} />
</Base>
