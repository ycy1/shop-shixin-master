<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.ShopTrendyParkTicketMapper">

    <!-- 公共查询列：表加了列只改这一处（别名固定是 t，和下面的 FROM 对应） -->
    <sql id="ticketColumns">
        t.id,
        t.ticket_no,
        t.ticket_name,
        t.ticket_type,
        t.park_id,
        t.price,
        <!-- 这一列在库里叫 time_slot（单数）、实体上叫 timeSlots（多选，逗号分隔）：
             自定义 XML 走的是"下划线转驼峰"的默认映射，不起这个别名就读回来是 null（BaseMapper 那几条靠 @TableField 认列名，不受影响） -->
        t.time_slot AS timeSlots,
        t.valid_days,
        t.max_per_order,
        t.description,
        t.status,
        t.sort,
        t.create_by,
        t.update_by,
        t.create_time,
        t.update_time
    </sql>

    <!-- 自定义 SQL 不走全局逻辑删除，t.is_deleted = 0 必须手写。
         园区名不在这里联：服务层按当页 park_id 一次查回来（形状同门店列表回填品牌名），
         这样"园区后来改了名"这一列跟着新名走 —— 它只是给人看在哪一家，不是凭证。
         真正要定格的是发到用户手上那张票的 ticket_name，那份快照在 shop_trendy_park_user_ticket 上。 -->
    <select id="selectTicketPage" resultType="com.shop.entity.ShopTrendyParkTicket">
        SELECT
            <include refid="ticketColumns"/>
        FROM shop_trendy_park_ticket t
        <where>
            t.is_deleted = 0
            <if test="q.parkId != null">
                AND t.park_id = #{q.parkId}
            </if>
            <if test="q.ticketType != null">
                AND t.ticket_type = #{q.ticketType}
            </if>
            <if test="q.status != null">
                AND t.status = #{q.status}
            </if>
            <!-- 一个输入框搜名称和编号 -->
            <if test="q.keyword != null and q.keyword != ''">
                AND (t.ticket_name LIKE CONCAT('%', #{q.keyword}, '%')
                OR t.ticket_no LIKE CONCAT('%', #{q.keyword}, '%'))
            </if>
        </where>
        <!-- 上架在前（status：1上架 0下架），同状态内按运营排的 sort、再按录入倒序（口径同盲盒列表） -->
        ORDER BY t.status DESC, t.sort ASC, t.id DESC
    </select>

</mapper>
