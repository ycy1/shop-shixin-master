<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.ShopCategoryMapper">

    <!-- 树形结构在 ShopCategoryServiceImpl 内用 stream 组装，这里只出扁平列表 -->
    <select id="selectCategoryList" resultType="com.shop.entity.ShopCategory">
        SELECT
            c.id,
            c.parent_id,
            c.category_name,
            c.sort,
            c.level,
            c.icon,
            c.status,
            c.user_id,
            c.create_by,
            c.update_by,
            c.create_time,
            c.update_time,
            i.icon_name,
            i.icon_type,
            i.icon_value
        FROM shop_category c
        <!--
            icon 列是 varchar 但存的是 shop_icon.id：直接写 i.id = c.icon 会触发
            字符串隐式转换，走不上 shop_icon 主键索引，所以显式 CAST。
            历史遗留的非数字值（如 EP 图标名 Goods）CAST 成 0，联不到记录，
            icon_type / icon_value 为空，前端 ShopIcon 会显示占位符。
            is_deleted 的过滤放在 ON 里，避免把图标被删的类目整行过滤掉。
        -->
        LEFT JOIN shop_icon i ON i.id = CAST(c.icon AS UNSIGNED) AND i.is_deleted = 0
        <!-- 自定义 SQL 不走全局逻辑删除，is_deleted = 0 必须手写 -->
        <where>
            c.is_deleted = 0
            <if test="q.keyword != null and q.keyword != ''">
                AND c.category_name LIKE CONCAT('%', #{q.keyword}, '%')
            </if>
            <if test="q.status != null">
                AND c.status = #{q.status}
            </if>
        </where>
        <!-- 启用在前（status：1启用 0禁用），同状态内仍按 sort、id -->
        ORDER BY c.status DESC, c.sort ASC, c.id ASC
    </select>

</mapper>
